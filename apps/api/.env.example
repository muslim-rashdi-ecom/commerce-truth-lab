# Environment Mode: 'development', 'testing', or 'production'
ENVIRONMENT=development

# Database Connection URL:
# Development / Local: sqlite+aiosqlite:///data/dev.db
# Production: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///data/dev.db

# JWT Secret Key for Bearer token signing (minimum 32 characters in production)
JWT_SECRET_KEY=dev_jwt_secret_key_not_for_production_min32chars!!

# Salt for SHA-256 PII pseudonymization (minimum 16 characters in production)
PSEUDONYMIZATION_SALT=dev_salt_min_16_chars_ctl

# Allowed CORS Origin(s) for frontend access
# In production, must specify exact origin (e.g. https://commerce-truth-lab.vercel.app), no wildcard '*'
FRONTEND_ORIGIN=http://localhost:5173

# Server Port (default: 8000)
PORT=8000
